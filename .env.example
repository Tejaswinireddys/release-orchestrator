# Run mode: "live" hits real APIs, "mock" uses the local mock server / UI mock.
RUN_MODE=mock
RELEASE_VERSION=1.4.0

# AWS / ECS (EC2 launch type)
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECS_CLUSTER=release-ec2-cluster
AWS_REGION=us-east-1

# Mock server base (used when RUN_MODE=mock)
MOCK_BASE_URL=http://localhost:4010

# Confluence
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=REL
CONFLUENCE_TOKEN=

# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_PROJECT_KEY=RM
JIRA_ISSUE_TYPE=Release
JIRA_TOKEN=

# Harness
HARNESS_BASE_URL=https://app.harness.io
HARNESS_ACCOUNT_ID=
HARNESS_ORG_ID=default
HARNESS_PROJECT_ID=release
HARNESS_PIPELINE_ID=ecs_ec2_deploy
HARNESS_API_KEY=

# OpenAI — change-summary intelligence.
# When OPENAI_API_KEY is set, the "summarize" stage uses OpenAI to turn each
# build's commits + changed files into human-readable release notes that are
# written into the Confluence page and the Jira RM ticket. When it is empty
# (e.g. CI / mock mode) a deterministic commit-derived summary is used instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
