{
  "name": "@release/orchestrator",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "orchestrate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "test": "vitest run --reporter=verbose --exclude '**/*.e2e.test.ts'",
    "e2e": "vitest run test/pipeline.e2e.test.ts --reporter=verbose",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  }
}
